  "title": {
   "en": "Love on Hold"
  },
  "altTitles": [
   {
    "ko": "모두에게 친절한 너는 왜"
   },
   {
    "en": "Why Are You So Kind to Everyone"
   },
   {
    "en": "The Reason You So Kind to Everyone"
   },
   {
    "en": "Why Are You So Kind To Everyone Except Me?"
   },
   {
    "ko-ro": "Moduege Chinjeolhan Neoneun Wae"
   }
