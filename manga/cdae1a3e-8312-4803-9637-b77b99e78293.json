  "title": {
   "en": "The Blue Wolves of Mibu: Shinsengumi Arc"
  },
  "altTitles": [
   {
    "ja": "青のミブロー新選組編ー"
   },
   {
    "ja-ro": "Ao no Miburo —Shinsengumi Hen—"
