    "ja": "君のラブを見せてくれ！"
   },
   {
    "ja-ro": "Kimi no Rabu wo Misetekure!"
   },
   {
    "en": "Show Me Your Love!"
   },
   {
    "zh-hk": "向我展露你的愛"
   },
   {
    "zh-ro": "Xiàng wǒ zhǎnlù nǐ de ài"
