   "en": "You and I Are Polar Opposites"
  },
  "altTitles": [
   {
    "ja": "正反対な君と僕"
   },
   {
    "ja-ro": "Seihantai na Kimi to Boku"
   },
   {
    "en": "The Polar Opposite You And Me"
   },
   {
    "th": "ลุ้นรักฉบับคู่ต่างขั้ว"
   },
   {
    "ru": "Ты и я — полные противоположности"
   }
