    "ko-ro": "Jugeo Jwo, Raneun Mareul Deureotda"
   },
   {
    "en": "I Was Told to Die"
   },
   {
    "en": "I Heard Someone Say, 'Die for Me'"
   },
   {
    "ja": "死んでくれと言われて"
