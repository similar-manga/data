 "attributes": {
  "title": {
   "en": "The Duke's Daughter Married the Fugitive"
  },
  "altTitles": [
   {
    "zh": "公爵小姐和逃犯闪婚了"
   },
   {
    "zh-ro": "Gōngjué Xiǎojiě Hé Táofàn Shǎnhūnle"
   },
   {
    "zh-ro": "Gongjue Xiaojie He Taofan Shanhunle"
   },
   {
    "en": "The Ducal Young Lady Had a Flash Marriage With a Fugitive"
   },
   {
    "en": "I Ran Away With My Contracted Husband"
   },
   {
    "ja": "契約夫と逃げ婚しました"
   },
   {
    "ja-ro": "Keiyaku Otto to Nigekon Shimashita"
   }
