   "en": "Osoraku Kanojo wa Ore no Aniki wo Neratteru"
  },
  "altTitles": [
   {
    "ja": "おそらくカノジョは俺の兄貴を狙ってる"
   },
   {
    "ja-ro": "Osoraku Kanojoha Oreno Anikiwo Neratteru"
   },
   {
    "en": "She's Likely Aiming for My Older Brother"
   },
   {
    "pt-br": "Ela provavelmente está mirando no meu irmão mais velho"
   }
